// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`githubScheduler > renders the workflow with the UTC cron and the summary 1`] = `
"# Generated by \`pochi schedule install --backend github\`. To change when it runs, edit
# schedule in context.yml and install again.
name: Briefing

on:
  schedule:
    # weekly on Monday and Thursday at 06:17 (Asia/Tokyo)
    - cron: "17 21 * * 0,3"
  workflow_dispatch:
    inputs:
      dry_run:
        description: Print the briefing instead of posting it, and leave the state file as is
        type: boolean
        default: false

permissions:
  contents: write

concurrency:
  group: briefing
  cancel-in-progress: false

jobs:
  briefing:
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      # The token stays out of .git/config, where install scripts and the build could read it.
      - uses: actions/checkout@v7
        with:
          persist-credentials: false
      - uses: actions/setup-node@v7
        with:
          node-version: 24
          cache: npm
      # No dependency lifecycle scripts; esbuild works without its postinstall.
      - run: npm ci --ignore-scripts
      - run: npm run build
      - name: Run pochi
        env:
          POCHI_CONTEXT_YAML: \${{ secrets.POCHI_CONTEXT_YAML }}
          POCHI_SOURCES_YAML: \${{ secrets.POCHI_SOURCES_YAML }}
          ANTHROPIC_API_KEY: \${{ secrets.ANTHROPIC_API_KEY }}
          TAVILY_API_KEY: \${{ secrets.TAVILY_API_KEY }}
          SLACK_WEBHOOK_URL: \${{ secrets.SLACK_WEBHOOK_URL }}
          GITHUB_TOKEN: \${{ secrets.GITHUB_TOKEN }}
          DRY_RUN: \${{ inputs.dry_run }}
        run: |
          if [ "$DRY_RUN" = "true" ]; then
            node dist/pochi.mjs run --dry-run
          else
            node dist/pochi.mjs run
          fi
      # Also after a failed run: what it delivered before failing is recorded and must not repeat.
      - name: Commit the state file
        if: \${{ !cancelled() && inputs.dry_run != true }}
        env:
          GITHUB_TOKEN: \${{ secrets.GITHUB_TOKEN }}
          SERVER_URL: \${{ github.server_url }}
        # The token reaches git through env for this step only: not on disk, not in argv.
        run: |
          [ -f state/notified.json ] || exit 0
          git add -f state/notified.json
          if git diff --cached --quiet; then exit 0; fi
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git commit -m "chore(state): record notified items [skip ci]"
          export GIT_CONFIG_COUNT=1
          export GIT_CONFIG_KEY_0="http.$SERVER_URL/.extraheader"
          export GIT_CONFIG_VALUE_0="AUTHORIZATION: basic $(printf 'x-access-token:%s' "$GITHUB_TOKEN" | base64 -w0)"
          git pull --rebase
          git push
"
`;
