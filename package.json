{
  "name": "pochi",
  "version": "0.1.0",
  "description": "Daily briefing for your project, delivered to Slack or Markdown files",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanatyu12/pochi.git"
  },
  "homepage": "https://github.com/tanatyu12/pochi#readme",
  "bugs": {
    "url": "https://github.com/tanatyu12/pochi/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "pochi": "dist/pochi.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "demo": "sh scripts/demo.sh"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "entities": "^7.0.1",
    "feedsmith": "^3.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
