<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- pochi-tasks implement: one issue labeled pochi:go → draft PR, every {{INTERVAL}} seconds. Written by pochi-tasks.mjs schedule from config/tasks.json. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>sh.pochi-tasks.implement.{{ID}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{NODE}}</string>
    <string>{{RUNNER}}</string>
    <string>implement</string>
  </array>
  <key>WorkingDirectory</key>
  <string>{{PROJECT_DIR}}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{PATH}}</string>
  </dict>
  <key>StartInterval</key>
  <integer>{{INTERVAL}}</integer>
  <key>StandardOutPath</key>
  <string>{{PROJECT_DIR}}/logs/pochi-tasks.log</string>
  <key>StandardErrorPath</key>
  <string>{{PROJECT_DIR}}/logs/pochi-tasks.log</string>
</dict>
</plist>
